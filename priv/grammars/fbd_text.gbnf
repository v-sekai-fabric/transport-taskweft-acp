# The text form of an FBD, as taskweft-fbd-compiler's `to-dsl` prints it and its
# `.fbd` reader accepts (RFD 2236). One line per block, literals inline, wires by
# name. The subset is the one `plcopen_fbd.gbnf` admits in XML; a completion under
# this grammar is the same POU with far fewer tokens.
#
#     program write_then_read
#     var done : BOOL
#     b3 = WRITE_FILE(PATH="out.txt", TEXT="hello")
#     b5 = READ_FILE(EN=b3.ENO, PATH="out.txt")
#     done = b5.ENO

root      ::= program vars blocks outs
program   ::= "program " name "\n"
vars      ::= var*
var       ::= "var " name " : " type ("= " literal)? "\n"
type      ::= "BOOL" | "INT" | "STRING"
blocks    ::= block+
block     ::= name " = " typeName "(" args ")\n"
typeName  ::= "WRITE_FILE" | "RUN" | "READ_FILE"
args      ::= arg ("," ws arg)*
arg       ::= pin "=" value
pin       ::= "EN" | "PATH" | "TEXT" | "CMD" | "ARGS"
value     ::= string | ref | name
ref       ::= name "." ("ENO" | "OUT")
outs      ::= out*
out       ::= name " = " ref "\n"
literal   ::= string | "TRUE" | "FALSE" | int
int       ::= "-"? [0-9]+
string    ::= "\"" strchar* "\""
strchar   ::= [^"\\'<>&\n] | "\\" ["\\nt]
name      ::= [a-zA-Z_] [a-zA-Z0-9_]*
ws        ::= " "?
